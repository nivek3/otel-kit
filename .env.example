# -------------------------------------------------------
# OpenTelemetry OTLP Exporter
# -------------------------------------------------------
# Jaeger OTLP/gRPC Receiver
OTEL_EXPORTER_OTLP_ENDPOINT="http://{your_ip}:4317"
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Sampling and metric intervals use native SDK settings or SDK defaults.
# Resource service naming uses SDK defaults, independently of LOG_SERVICE_NAME.
OTEL_SERVICE_NAME="service" # users/articles/demos
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_METRIC_EXPORT_INTERVAL=30000 # milliseconds

# export logs to otel
LOG_OTEL_LOGS_ENABLED=true

# -------------------------------------------------------
# LOG with base
# -------------------------------------------------------
RUST_LOG=info
LOG_SERVICE_NAME="service" # tracer instrumentation scope
LOG_FORMAT=json
LOG_SPAN_EVENTS=FMT::NONE
LOG_CONSOLE_ENABLED=false

# -------------------------------------------------------
# LOG with fileappender
# -------------------------------------------------------
LOG_FILE_ENABLE=true
LOG_FILE_DIR=./logs
LOG_FILE_FILENAME_PREFIX=app
LOG_FILE_FILENAME_SUFFIX=log
LOG_FILE_MAX_LOG_FILES=10
LOG_FILE_ROTATION=daily
LOG_FILE_NON_BLOCKING=true
